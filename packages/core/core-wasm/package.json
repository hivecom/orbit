{
  "name": "core-wasm",
  "version": "0.1.0",
  "files": [
    "pkg"
  ],
  "type": "module",
  "sideEffects": [
    "./pkg/snippets/*"
  ],
  "main": "./pkg/core_wasm.js",
  "types": "./pkg/core_wasm.d.ts",
  "exports": {
    ".": {
      "import": "./pkg/core_wasm.js"
    },
    "./types": {
      "types": "./core_wasm.d.ts"
    }
  },
  "scripts": {
    "build": "wasm-pack build . --target web && rm ./pkg/.gitignore",
    "dev": "cargo watch -i pkg -s 'wasm-pack build . --target web'"
  }
}
